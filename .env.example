# Supabase: Project Settings > API (crear un proyecto NUEVO para esta boda).
# Copiar este archivo como .env y completar. Pasos completos en supabase/README.md.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Modo demo: true = datos de prueba en el navegador (sin tocar Supabase).
# Para produccion: false, o quitar la linea.
VITE_USE_DEMO=false
